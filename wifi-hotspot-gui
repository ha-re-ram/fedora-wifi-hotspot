#!/usr/bin/env python3

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Pango, Gio
import subprocess
import os
import threading

PROJECT_DIR = os.path.dirname(os.path.realpath(__file__))
GLOBAL_BIN = "/usr/local/lib/fedora-wifi-hotspot/wifi-hotspot"

if os.path.exists(GLOBAL_BIN):
    HOTSPOT_BIN = GLOBAL_BIN
else:
    HOTSPOT_BIN = os.path.join(PROJECT_DIR, "wifi-hotspot")

class HotspotGUI(Gtk.ApplicationWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        
        self.set_default_size(550, 650)
        self.set_position(Gtk.WindowPosition.CENTER)
        
        # HeaderBar for a native GNOME look
        hb = Gtk.HeaderBar()
        hb.set_show_close_button(True)
        hb.props.title = "Fedora Wi-Fi Hotspot"
        hb.props.subtitle = "Share your internet connection easily"
        self.set_titlebar(hb)
        
        # Add About/GitHub button to HeaderBar
        about_btn = Gtk.Button.new_from_icon_name("help-about-symbolic", Gtk.IconSize.BUTTON)
        about_btn.connect("clicked", self.on_about_clicked)
        hb.pack_end(about_btn)
        
        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        self.main_box.set_margin_top(25)
        self.main_box.set_margin_bottom(25)
        self.main_box.set_margin_start(35)
        self.main_box.set_margin_end(35)
        self.add(self.main_box)
        
        # Status Box (Card-like appearance)
        status_frame = Gtk.Frame()
        status_frame.set_shadow_type(Gtk.ShadowType.IN)
        status_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=15)
        status_box.set_margin_top(20)
        status_box.set_margin_bottom(20)
        status_frame.add(status_box)
        self.main_box.pack_start(status_frame, False, False, 0)
        
        self.status_icon = Gtk.Image.new_from_icon_name("network-wireless-disconnected-symbolic", Gtk.IconSize.DIALOG)
        self.status_icon.set_pixel_size(72)
        status_box.pack_start(self.status_icon, False, False, 0)
        
        self.status_label = Gtk.Label(label="Hotspot is Off")
        self.status_label.modify_font(Pango.FontDescription("sans bold 18"))
        status_box.pack_start(self.status_label, False, False, 0)
        
        # Power Switch Box
        switch_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=15)
        switch_box.set_halign(Gtk.Align.CENTER)
        
        lbl_switch = Gtk.Label(label="Toggle Hotspot:")
        lbl_switch.modify_font(Pango.FontDescription("sans 12"))
        switch_box.pack_start(lbl_switch, False, False, 0)
        
        self.toggle_switch = Gtk.Switch()
        self.toggle_switch.set_size_request(80, 35)
        self.toggle_switch.connect("notify::active", self.on_switch_activated)
        switch_box.pack_start(self.toggle_switch, False, False, 0)
        status_box.pack_start(switch_box, False, False, 5)
        
        # Settings Section
        lbl_settings = Gtk.Label(label="<b>Network Configuration</b>")
        lbl_settings.set_use_markup(True)
        lbl_settings.set_halign(Gtk.Align.START)
        self.main_box.pack_start(lbl_settings, False, False, 0)
        
        settings_frame = Gtk.Frame()
        self.main_box.pack_start(settings_frame, False, False, 0)
        
        grid = Gtk.Grid(row_spacing=12, column_spacing=15)
        grid.set_margin_top(20)
        grid.set_margin_bottom(20)
        grid.set_margin_start(20)
        grid.set_margin_end(20)
        settings_frame.add(grid)
        
        lbl_ssid = Gtk.Label(label="Network Name (SSID):")
        lbl_ssid.set_halign(Gtk.Align.END)
        self.entry_ssid = Gtk.Entry()
        self.entry_ssid.set_text("Fedora_Hotspot")
        self.entry_ssid.set_hexpand(True)
        grid.attach(lbl_ssid, 0, 0, 1, 1)
        grid.attach(self.entry_ssid, 1, 0, 1, 1)
        
        lbl_pwd = Gtk.Label(label="Password (WPA2):")
        lbl_pwd.set_halign(Gtk.Align.END)
        self.entry_pwd = Gtk.Entry()
        self.entry_pwd.set_text("12345678")
        self.entry_pwd.set_visibility(False)
        self.entry_pwd.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        grid.attach(lbl_pwd, 0, 1, 1, 1)
        grid.attach(self.entry_pwd, 1, 1, 1, 1)

        self.check_show_pwd = Gtk.CheckButton(label="Show Password")
        self.check_show_pwd.connect("toggled", self.on_show_pwd_toggled)
        grid.attach(self.check_show_pwd, 1, 2, 1, 1)

        # Actions Section
        action_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        action_box.set_halign(Gtk.Align.CENTER)
        self.main_box.pack_start(action_box, False, False, 0)
        
        self.btn_refresh = Gtk.Button(label="Refresh Connected Devices")
        self.btn_refresh.connect("clicked", self.on_refresh_clicked)
        self.btn_refresh.set_sensitive(False)
        action_box.pack_start(self.btn_refresh, False, False, 0)
        
        self.btn_force_stop = Gtk.Button(label="Force Stop")
        self.btn_force_stop.connect("clicked", lambda x: self.stop_hotspot())
        self.btn_force_stop.get_style_context().add_class("destructive-action")
        action_box.pack_start(self.btn_force_stop, False, False, 0)
        
        # Terminal / Log output
        lbl_logs = Gtk.Label(label="<b>System Logs</b>")
        lbl_logs.set_use_markup(True)
        lbl_logs.set_halign(Gtk.Align.START)
        self.main_box.pack_start(lbl_logs, False, False, 0)
        
        self.textview = Gtk.TextView()
        self.textview.set_editable(False)
        self.textview.set_wrap_mode(Gtk.WrapMode.WORD)
        self.textview.modify_font(Pango.FontDescription("monospace 10"))
        # Add basic styling to make it look like a terminal
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(b"textview { background-color: #1e1e1e; color: #00ff00; padding: 10px; }")
        self.textview.get_style_context().add_provider(css_provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_min_content_height(250)
        scroll.add(self.textview)
        self.main_box.pack_start(scroll, True, True, 0)

        self.is_running = False

    def on_about_clicked(self, widget):
        about = Gtk.AboutDialog()
        about.set_transient_for(self)
        about.set_program_name("Fedora Wi-Fi Hotspot")
        about.set_version("1.1.0")
        about.set_comments("A lightweight tool with a beautiful GUI to share your Wi-Fi connection on Fedora Linux.")
        about.set_website("https://github.com/ha-re-ram/fedora-wifi-hotspot")
        about.set_website_label("GitHub Repository")
        about.set_authors(["shubhamcoder260 (Backend)", "ha-re-ram (GUI & Enhancements)"])
        about.set_logo_icon_name("network-wireless-symbolic")
        about.run()
        about.destroy()

    def on_show_pwd_toggled(self, button):
        self.entry_pwd.set_visibility(button.get_active())

    def append_output(self, text):
        buffer = self.textview.get_buffer()
        end_iter = buffer.get_end_iter()
        buffer.insert(end_iter, text + "\n")
        mark = buffer.create_mark(None, buffer.get_end_iter(), False)
        self.textview.scroll_to_mark(mark, 0.05, True, 0.0, 1.0)
        
    def set_ui_state(self, is_active):
        self.is_running = is_active
        # Silently sync switch state without triggering on_switch_activated
        self.toggle_switch.handler_block_by_func(self.on_switch_activated)
        self.toggle_switch.set_active(is_active)
        self.toggle_switch.handler_unblock_by_func(self.on_switch_activated)
            
        if is_active:
            self.status_icon.set_from_icon_name("network-wireless-signal-excellent-symbolic", Gtk.IconSize.DIALOG)
            self.status_label.set_text("Hotspot is Active")
            self.entry_ssid.set_sensitive(False)
            self.entry_pwd.set_sensitive(False)
            self.btn_refresh.set_sensitive(True)
        else:
            self.status_icon.set_from_icon_name("network-wireless-disconnected-symbolic", Gtk.IconSize.DIALOG)
            self.status_label.set_text("Hotspot is Off")
            self.entry_ssid.set_sensitive(True)
            self.entry_pwd.set_sensitive(True)
            self.btn_refresh.set_sensitive(False)

    def on_switch_activated(self, switch, gparam):
        if switch.get_active():
            self.start_hotspot()
        else:
            self.stop_hotspot()
            
    def start_hotspot(self):
        ssid = self.entry_ssid.get_text().strip()
        pwd = self.entry_pwd.get_text().strip()
        if not ssid or not pwd:
            self.append_output("Error: SSID and Password cannot be empty.")
            # Revert switch state
            self.toggle_switch.handler_block_by_func(self.on_switch_activated)
            self.toggle_switch.set_active(False)
            self.toggle_switch.handler_unblock_by_func(self.on_switch_activated)
            return
            
        cmd = ["sudo", HOTSPOT_BIN, "start", "--ssid", ssid, "--password", pwd]
        self.run_command_async(cmd, starting=True)

    def stop_hotspot(self):
        cmd = ["sudo", HOTSPOT_BIN, "stop"]
        self.run_command_async(cmd, starting=False)
        
    def on_refresh_clicked(self, widget):
        cmd = ["sudo", HOTSPOT_BIN, "status"]
        self.run_command_async(cmd, starting=self.is_running, refresh_only=True)

    def run_command_async(self, cmd, starting, refresh_only=False):
        self.toggle_switch.set_sensitive(False)
        self.btn_refresh.set_sensitive(False)
        self.btn_force_stop.set_sensitive(False)
        
        if not refresh_only:
            self.textview.get_buffer().set_text("")
            
        self.append_output(f"Executing: {' '.join(cmd)}")
        
        def run():
            try:
                process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
                for line in process.stdout:
                    GLib.idle_add(self.append_output, line.strip('\n'))
                process.wait()
                if not refresh_only:
                    if process.returncode == 0:
                        GLib.idle_add(self.set_ui_state, starting)
                    else:
                        GLib.idle_add(self.set_ui_state, False)
                else:
                    GLib.idle_add(self.btn_refresh.set_sensitive, True)
                    
            except Exception as e:
                GLib.idle_add(self.append_output, f"Error: {e}")
                if not refresh_only:
                    GLib.idle_add(self.set_ui_state, False)
            finally:
                GLib.idle_add(self.toggle_switch.set_sensitive, True)
                GLib.idle_add(self.btn_force_stop.set_sensitive, True)
                
        threading.Thread(target=run, daemon=True).start()

class HotspotApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.github.fedorawifihotspot", flags=Gio.ApplicationFlags.FLAGS_NONE)
        
    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = HotspotGUI(application=self)
        win.show_all()
        win.present()

if __name__ == "__main__":
    app = HotspotApp()
    app.run(None)
